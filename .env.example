PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=pathfinder_user
DB_PASSWORD=pathfinder_pass
DB_NAME=pathfinder_db

# For external/cloud databases, set DB_HOST to your provider's hostname
# SSL is enabled automatically when DB_HOST is not localhost

# JWT Authentication
# Use a strong random string of at least 64 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters
JWT_EXPIRES_IN=7d

# E2E test configuration
# The running server URL for end-to-end tests
E2E_BASE_URL=http://localhost:3000

# Allowed CORS origin (production only)
# Set this to your frontend URL. Example: https://your-app.onrender.com
# Leave empty in development to allow all origins
ALLOWED_ORIGIN=
