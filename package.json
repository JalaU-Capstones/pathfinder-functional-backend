{
  "name": "pathfinder-functional-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest tests/unit",
    "test:coverage": "jest tests/unit --coverage",
    "test:coverage:watch": "jest tests/unit --coverage --watchAll",
    "test:ci": "cross-env NODE_ENV=test jest tests/unit --coverage --ci --forceExit --silent --passWithNoTests",
    "test:e2e": "jest tests/e2e --runInBand --forceExit --testTimeout=30000",
    "test:e2e:verbose": "jest tests/e2e --runInBand --forceExit --testTimeout=30000 --verbose",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "db:test-connection": "node scripts/test-db.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JalaU-Capstones/pathfinder-functional-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JalaU-Capstones/pathfinder-functional-backend/issues"
  },
  "homepage": "https://github.com/JalaU-Capstones/pathfinder-functional-backend#readme",
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "tests/e2e/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/sequelize.cli.js",
      "!src/config/swagger.js",
      "!src/server.js",
      "!src/data/migrations/**",
      "!src/data/seeders/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 65,
        "branches": 70,
        "functions": 70,
        "lines": 65
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov",
      "cobertura"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
