        <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Global ID Extractor (Postman Equivalent)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

try {
    if (prev.getResponseCode() == &apos;204&apos; || !prev.getResponseDataAsString()) return
    def res = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (!(res instanceof Map)) return

    def extract = { val -&gt;
        if (val == null) return null
        if (val instanceof List) {
            if (!val.isEmpty()) return val[0].toString()
            return null
        }
        return val.toString()
    }

    // ─── JWT Token ───
    if (res.containsKey(&apos;token&apos;) &amp;&amp; res.get(&apos;token&apos;) != null) vars.put(&apos;token&apos;, extract(res.get(&apos;token&apos;)))
    if (res.data instanceof Map &amp;&amp; res.data.containsKey(&apos;token&apos;) &amp;&amp; res.data.get(&apos;token&apos;) != null) vars.put(&apos;token&apos;, extract(res.data.get(&apos;token&apos;)))

    // ─── User ID ───
    if (res.user instanceof Map &amp;&amp; res.user.containsKey(&apos;id&apos;) &amp;&amp; res.user.get(&apos;id&apos;) != null) vars.put(&apos;userId&apos;, extract(res.user.get(&apos;id&apos;)))
    if (res.data instanceof Map &amp;&amp; res.data.user instanceof Map &amp;&amp; res.data.user.containsKey(&apos;id&apos;) &amp;&amp; res.data.user.get(&apos;id&apos;) != null) vars.put(&apos;userId&apos;, extract(res.data.user.get(&apos;id&apos;)))

    def path = &apos;&apos;
    try { path = sampler.getPath() } catch (Exception e) {}

    // ─── Map ID ───
    if (res.containsKey(&apos;id&apos;) &amp;&amp; res.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/maps&apos;)) vars.put(&apos;mapId&apos;, extract(res.get(&apos;id&apos;)))
    if (res.data instanceof Map &amp;&amp; res.data.containsKey(&apos;id&apos;) &amp;&amp; res.data.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/maps&apos;)) vars.put(&apos;mapId&apos;, extract(res.data.get(&apos;id&apos;)))

    // ─── Obstacle ID ───
    if (res.containsKey(&apos;id&apos;) &amp;&amp; res.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/obstacles&apos;)) vars.put(&apos;obstacleId&apos;, extract(res.get(&apos;id&apos;)))
    if (res.data instanceof Map &amp;&amp; res.data.containsKey(&apos;id&apos;) &amp;&amp; res.data.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/obstacles&apos;)) vars.put(&apos;obstacleId&apos;, extract(res.data.get(&apos;id&apos;)))

    // ─── Waypoint IDs ───
    def wpId = res.containsKey(&apos;id&apos;) ? res.get(&apos;id&apos;) : (res.data instanceof Map ? res.data.get(&apos;id&apos;) : null)
    if (wpId != null &amp;&amp; path.contains(&apos;/waypoints&apos;)) {
        def label = &apos;&apos;
        try {
            def bodyStr = sampler.getArguments().getArgument(0).getValue()
            if (bodyStr) {
                def body = new JsonSlurper().parseText(bodyStr)
                if (body instanceof Map) {
                    label = extract(body.get(&apos;name&apos;) ?: body.get(&apos;label&apos;) ?: &apos;&apos;).toLowerCase()
                }
            }
        } catch (Exception e) {}
        def wpIdStr = extract(wpId)
        if (label.contains(&apos;start&apos;)) vars.put(&apos;startWaypointId&apos;, wpIdStr)
        else if (label.contains(&apos;end&apos;)) vars.put(&apos;endWaypointId&apos;, wpIdStr)
        else vars.put(&apos;waypointId&apos;, wpIdStr)
    }

    // ─── Route ID ───
    if (res.containsKey(&apos;id&apos;) &amp;&amp; res.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/routes&apos;)) vars.put(&apos;routeId&apos;, extract(res.get(&apos;id&apos;)))
    if (res.data instanceof Map &amp;&amp; res.data.containsKey(&apos;id&apos;) &amp;&amp; res.data.get(&apos;id&apos;) != null &amp;&amp; path.contains(&apos;/routes&apos;)) vars.put(&apos;routeId&apos;, extract(res.data.get(&apos;id&apos;)))
} catch (Exception e) {
    log.warn(&apos;Error parsing response: &apos; + e.getMessage())
}</stringProp>
        </JSR223PostProcessor>
